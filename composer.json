{
    "name": "inboundr/inboundr",
    "description": "PHP SDK for the Inboundr API: receive email over signed webhooks, read and reply to it.",
    "type": "library",
    "license": "MIT",
    "keywords": ["email", "inbound-email", "webhook", "webhook-verification", "inboundr"],
    "homepage": "https://inboundr.net",
    "authors": [{ "name": "Inboundr", "email": "dev@inboundr.net" }],
    "support": {
        "issues": "https://github.com/inboundr-net/inboundr-php/issues",
        "source": "https://github.com/inboundr-net/inboundr-php",
        "docs": "https://inboundr.net/docs"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/yaml": "^7.1"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Used automatically, with a 30s timeout, when no PSR-18 client is passed."
    },
    "autoload": {
        "psr-4": { "Inboundr\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Inboundr\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "php-http/discovery": false }
    },
    "scripts": {
        "test": ["phpunit", "phpstan analyse --no-progress --memory-limit=1G"],
        "types": "php scripts/generate-types.php",
        "spec:sync": "php scripts/generate-types.php --sync"
    }
}
